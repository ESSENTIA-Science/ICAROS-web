# ── Database ────────────────────────────────────────────────
# 로컬: compose.yaml 의 postgres:17 (포트 5435)
DATABASE_URL=postgres://icaros:icaros_local_dev@localhost:5435/icaros
# 마이그레이션 전용 — Neon 연결 시 반드시 -pooler 없는 직결 엔드포인트를 쓴다
DATABASE_URL_UNPOOLED=postgres://icaros:icaros_local_dev@localhost:5435/icaros

# ── Auth ────────────────────────────────────────────────────
# 관리자 mutation 의 Origin 화이트리스트 (06 §5).
# 형식: 콤마 구분, 스킴 포함 절대 URL. 경로·포트 외 요소·후행 슬래시는 붙이지 않는다.
#   예) https://icaros.kr,https://www.icaros.kr,https://icaros-web-preview.vercel.app
# 설정하면 **이 목록만** 허용한다 — x-forwarded-host 로 조립한 self-origin 을 더하지 않는다.
# 비우면 self-origin 폴백 + 서버 경고로 내려간다 (검증이 요청의 자기 신고로 축소됨). 로컬 전용.
# 값을 넣었는데 하나도 파싱되지 않으면 모든 mutation 을 거부한다 (fail-closed).
ADMIN_ALLOWED_ORIGINS=http://localhost:5174

# ── Database: 배포(IAM 인증) ─────────────────────────────────
# DB_AUTH=iam 이면 아래를 쓰고 DATABASE_URL 은 무시된다. **비밀번호는 없다** —
# 15분 수명 IAM 토큰을 커넥션마다 발급한다 (DECISIONS D20).
# DB_AUTH=iam
# PGHOST=<rds-host>
# PGPORT=5432
# PGDATABASE=essentia
# PGUSER=icaros_app                # 마이그레이션은 icaros_migrator (파이프라인 전용)
# RDS CA 번들 — verify-full 에 필요. sslmode=require 는 암호화만 하고 서버 인증서를 검증하지 않는다.
#   curl -o rds-ca.pem https://truststore.pki.rds.amazonaws.com/ap-northeast-2/ap-northeast-2-bundle.pem
# RDS_CA_BUNDLE_PATH=./rds-ca.pem
#   또는 PEM 본문을 그대로: RDS_CA_BUNDLE="-----BEGIN CERTIFICATE-----..."

# ── S3 (Gate 4 P4 이후) ─────────────────────────────────────
# 런타임은 OIDC 역할 수임을 쓴다 (DECISIONS D5). 장기 키를 여기에 넣지 않는다.
S3_BUCKET=
S3_PREFIX=icaros-web
AWS_REGION=ap-northeast-2

# ── ESSENTIA Community ─────────────────────────────────────
# /posts 의 단일 원본. 읽기는 인증 불필요 — 서비스 토큰(D1)은 쓰기에만 필요하다.
# **서버 사이드에서만 호출한다** (D22). 브라우저에 이 값이 나가면 안 된다.
ESSENTIA_API_BASE=https://api.essentia-sci.org

# ── Cron ────────────────────────────────────────────────────
# /api/cron/storage 인증용 공유 비밀. Vercel Cron 이 Authorization: Bearer 로 보낸다.
# 미설정이면 엔드포인트가 전부 401 — 즉 정리 큐를 아무도 비우지 않는다.
CRON_SECRET=

# ── 레거시 export 전용 (일회성, 런타임 미사용) ───────────────
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_ANON_KEY=
