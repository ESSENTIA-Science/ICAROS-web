{
  "name": "@icaros/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint src test",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/handler.ts src/api.ts src/local-server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist"
  },
  "devDependencies": {
    "@icaros/contracts": "0.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront-keyvaluestore": "^3.1143.0",
    "@aws-sdk/client-codebuild": "^3.1143.0",
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@node-rs/argon2": "^2.2.1",
    "@vercel/functions": "^3.9.9",
    "pg": "^8.23.0"
  }
}
