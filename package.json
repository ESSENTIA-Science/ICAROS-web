{
  "name": "icaros-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:web:fixture": "node scripts/build-web-fixture.mjs",
    "build:web:local": "node scripts/build-web-local.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "legacy:build": "npm run build --prefix legacy",
    "legacy:typecheck": "npm run typecheck --prefix legacy",
    "legacy:lint": "npm run lint --prefix legacy"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "pg": "^8.23.0"
  }
}
